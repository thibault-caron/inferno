  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget, QWidget#contentArea, QWidget#mainPanel {
    background-color: #F4F6F5;
}
QListWidget, QListView {
    background-color: #ffffff;
    border: 1px solid #89B6A5;
    border-radius: 6px;
    padding: 4px;
    color: #4C3B4D;
    font-size: 13px;
}
QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}
QListWidget::item:selected {
    background-color: #C9EDDC;
    color: #4C3B4D;
}
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #82968C;
    border-radius: 6px;
    padding: 7px 10px;
    color: #4C3B4D;
    font-size: 13px;
}
QLineEdit:focus {
    border: 1px solid #4C3B4D;
}
QPushButton {
    background-color: #4C3B4D;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #6A706E;
}
QPushButton:pressed {
    background-color: #82968C;
}
QPushButton#osInfoButton, QPushButton#processListButton, QPushButton#presetDfButton, QPushButton#presetNetstatButton, QPushButton#presetTopButton {
    background-color: #dde3e0;
    color: #4C3B4D;
    border: 1px solid #82968C;
    font-weight: normal;
}
QPushButton#disconnectButton {
    background-color: #ffffff;
    color: #b23b3b;
    border: 1px solid #d99a9a;
}
QPushButton#osInfoButton:hover, QPushButton#processListButton:hover, QPushButton#disconnectButton:hover, QPushButton#presetDfButton:hover, QPushButton#presetNetstatButton:hover, QPushButton#presetTopButton:hover {
background-color: #eef1f0;
}
QPushButton#osInfoButton:pressed, QPushButton#processListButton:pressed, QPushButton#disconnectButton:pressed, QPushButton#presetDfButton:pressed, QPushButton#presetNetstatButton:pressed, QPushButton#presetTopButton:pressed {
background-color: #dfe4e2;
}
QTextEdit {
    background-color: #4C3B4D;
    color: #C9EDDC;
    border: none;
    border-radius: 6px;
    padding: 10px;
    font-family: "Consolas", monospace;
    font-size: 12px;
}QLabel#brandLabel {
color: #4C3B4D;
font-size: 20px;
font-weight: bold;
}
QLabel#subtitleLabel {
color: #82968C;
font-size: 12px;
}
QLabel#agentsLabel {
color: #6A706E;
font-size: 11px;
font-weight: bold;
padding-top: 12px;
}
QLabel#executeLabel {
color: #6A706E;
font-size: 11px;
font-weight: bold;
padding-right: 8px;
}
QLabel#offlineLabel {
color: #82968C;
font-size: 11px;
}QLabel#agentNameLabel {
color: #4C3B4D;
font-size: 18px;
font-weight: bold;
padding-right: 8px;
}
QLabel#osBadge, QLabel#ipBadge, QLabel#statusBadge {
font-size: 12px;
padding: 2px 8px;
border-radius: 9px;
}
QLabel#osBadge {
background-color: #d6ece1;
color: #3f6b58;
}
QLabel#ipBadge {
background-color: #e4e2ee;
color: #52506b;
}
QLabel#statusBadge {
background-color: #d6ece1;
color: #3f6b58;
}
QLabel#statusBadge[streaming="false"] {
background-color: #f5dcdb;
color: #8c3b38;
}
QLabel#agentItemName {
color: #4C3B4D;
font-size: 13px;
}
QLabel#agentItemDetails {
color: #82968C;
font-size: 11px;
}
QLabel#agentStatusDot {
color: #89B6A5;
font-size: 14px;
}
QLabel#agentStatusDot[online="false"] {
color: #C0504D;
}QFrame#metricCard {
background-color: #ffffff;
border: 1px solid #e2e6e4;
border-radius: 8px;
}
QLabel#metricTitle {
color: #6A706E;
font-size: 12px;
}
QLabel#metricValue {
color: #2f2833;
font-size: 26px;
font-weight: 500;
}
QLabel#metricSubtitle {
color: #9aa0a0;
font-size: 11px;
}
QLabel#sectionTitle {
color: #6A706E;
font-size: 11px;
font-weight: bold;
padding-top: 8px;
}
QWidget#processGrid {
background-color: #ffffff;
border: 1px solid #e2e6e4;
border-radius: 8px;
}
QLabel#processCell {
color: #4C3B4D;
font-size: 13px;
font-weight: 700;
}
QLabel#processPid {
color: #4C3B4D;
font-size: 13px;
font-weight: normal;
}
QLabel#processHeaderCell {
color: #9aa0a0;
font-size: 12px;
}
QLabel#processFooter {
color: #9aa0a0;
font-size: 12px;
}
QProgressBar#processBar {
background-color: #e8ebe9;
border: none;
border-radius: 3px;
}
QProgressBar#processBar::chunk {
background-color: #7fae94;
border-radius: 3px;
}
QProgressBar#processBar[high="true"]::chunk {
background-color: #e0b062;
}
QLabel#processStatus {
color: #5a9b78;
font-size: 13px;
}
QWidget#processSeparator {
background-color: #eef0ef;
}</string>
